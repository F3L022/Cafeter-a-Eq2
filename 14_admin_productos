<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrador de Productos - Café Central</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>

<div class="app-container wide">
    <header class="app-header">
        <div class="logo-area">
            <i class="fa-solid fa-mug-hot"></i>
            <span>CAFÉ CENTRAL - MIS PRODUCTOS</span>
        </div>
        <button class="nav-toggle" id="navToggle"><i class="fa-solid fa-bars"></i></button>
    </header>

    <main class="app-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
            <h2 style="color: var(--primary-brown);">MIS PRODUCTOS</h2>
            <button class="btn-green" id="btnAgregarProducto"><i class="fa-solid fa-plus"></i> AGREGAR PRODUCTO</button>
        </div>

        <div class="table-responsive">
            <table class="custom-table" id="tablaProductos">
                <thead>
                    <tr>
                        <th>PRODUCTO</th>
                        <th>PRECIO</th>
                        <th>CATEGORÍA</th>
                        <th>ACCIÓN</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="text-center mt-3">
            <a href="13_panel_dueno.html" class="btn-secondary">← VOLVER</a>
        </div>
    </main>
</div>

<!-- Modal Agregar/Editar Producto -->
<div class="modal-overlay" id="modalProducto">
    <div class="modal-content">
        <h3 class="text-center mb-3" style="color: var(--primary-brown);" id="modalProdTitle">Nuevo Producto</h3>
        <form id="formProducto">
            <div class="form-group">
                <label>Nombre del Producto:</label>
                <input type="text" id="prodNombre" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Precio ($):</label>
                <input type="number" step="0.5" id="prodPrecio" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Categoría:</label>
                <select id="prodCategoria" class="form-control" required>
                    <option value="Cafés">Cafés</option>
                    <option value="Postres">Postres</option>
                    <option value="Bebidas">Bebidas</option>
                </select>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button type="submit" class="btn-green btn-block">Guardar</button>
                <button type="button" class="btn-red btn-block" id="btnCerrarModal">Cancelar</button>
            </div>
        </form>
    </div>
</div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="js/app.js"></script>
    
    <script src="js/productos.js"></script>
    <script>
$(document).ready(function(){
    var indiceEditando = -1;

    function dibujarTabla(){
        var lista = leerProductos();
        var filas = '';
        for (var i = 0; i < lista.length; i++) {
            filas += '<tr data-i="' + i + '"><td>' + lista[i].nombre + '</td><td>$' + lista[i].precio + '</td><td>' + lista[i].categoria + '</td>' +
                '<td><i class="fa-solid fa-pen-to-square btn-edit" style="color:#0d6efd; cursor:pointer; margin-right:10px;"></i>' +
                '<i class="fa-solid fa-trash btn-delete" style="color:#dc3545; cursor:pointer;"></i></td></tr>';
        }
        $('#tablaProductos tbody').html(filas);
    }

    $('#btnAgregarProducto').click(function(){
        indiceEditando = -1;
        $('#modalProdTitle').text('Nuevo Producto');
        $('#formProducto')[0].reset();
        $('#modalProducto').css('display', 'flex');
    });

    $(document).on('click', '.btn-edit', function(){
        indiceEditando = $(this).closest('tr').data('i');
        var p = leerProductos()[indiceEditando];
        $('#modalProdTitle').text('Editar Producto');
        $('#prodNombre').val(p.nombre);
        $('#prodPrecio').val(p.precio);
        $('#prodCategoria').val(p.categoria);
        $('#modalProducto').css('display', 'flex');
    });

    $('#btnCerrarModal').click(function(){
        $('#modalProducto').hide();
    });

    $(document).on('click', '.btn-delete', function(){
        if(confirm('¿Deseas eliminar este producto del catálogo?')){
            var lista = leerProductos();
            lista.splice($(this).closest('tr').data('i'), 1);
            guardarProductos(lista);
            dibujarTabla();
        }
    });

    $('#formProducto').submit(function(e){
        e.preventDefault();
        var precio = parseFloat($('#prodPrecio').val());
        if (isNaN(precio) || precio < 0) {
            alert('El precio no puede ser negativo.');
            return;
        }
        var producto = { nombre: $('#prodNombre').val(), precio: precio, categoria: $('#prodCategoria').val() };
        var lista = leerProductos();
        if (indiceEditando >= 0) {
            lista[indiceEditando] = producto;
        } else {
            lista.push(producto);
        }
        guardarProductos(lista);
        $('#modalProducto').hide();
        dibujarTabla();
    });

    dibujarTabla();
});
</script>
</body>
</html>
